{
  "manifest_version": 3,
  "name": "QQ ChatGPT 网页桥接",
  "version": "0.3.4",
  "minimum_chrome_version": "120",
  "description": "把本机 Koishi 收到的 QQ 消息原样送进 ChatGPT 普通聊天网页，并把回复原样送回。",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"}
}
