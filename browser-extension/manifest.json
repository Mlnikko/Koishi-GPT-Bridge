{
  "manifest_version": 3,
  "name": "QQ ChatGPT 生图连接器",
  "version": "0.1.0",
  "description": "将本机 Koishi 绘图任务送到 ChatGPT 普通聊天网页，并取回本轮图片。",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:5141/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"}
}
