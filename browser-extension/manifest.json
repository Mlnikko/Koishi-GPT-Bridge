{
  "manifest_version": 3,
  "name": "QQ ChatGPT 网页桥接",
  "version": "0.4.4",
  "minimum_chrome_version": "120",
  "description": "把 QQ 消息送进 ChatGPT 聊天或工作页面，支持原生 @技能，并将网页回复送回。",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
