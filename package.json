{
  "name": "koishi-plugin-chatgpt-bridge",
  "version": "0.4.4",
  "description": "QQ 中的 ChatGPT 网页与 LM Studio 助手：连续对话、图片问答、网页生图和改图、原生技能、图片模板及多话题管理。",
  "main": "src/index.cjs",
  "author": "Mlnikko",
  "homepage": "https://www.npmjs.com/package/koishi-plugin-chatgpt-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mlnikko/Koishi-GPT-Bridge.git"
  },
  "keywords": [
    "koishi",
    "chatgpt",
    "qq",
    "lmstudio",
    "ai"
  ],
  "files": [
    "src/**/*.cjs",
    "browser-extension/manifest.json",
    "browser-extension/background.js",
    "browser-extension/bridge-client.js",
    "browser-extension/page.js",
    "browser-extension/popup.html",
    "browser-extension/popup.js",
    "examples/",
    "scripts/setup-web-bridge.cjs",
    "scripts/install-browser-extension.cjs",
    "scripts/doctor.cjs",
    "koishi.example.yml",
    "docs/installation.md",
    "docs/operations.md",
    "docs/user-guide.md",
    "docs/three-modes.md",
    "docs/publishing.md",
    "docs/architecture.md"
  ],
  "bin": {
    "koishi-gpt-bridge-setup": "scripts/install-browser-extension.cjs",
    "koishi-gpt-bridge-doctor": "scripts/doctor.cjs"
  },
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "devDependencies": {
    "koishi": "4.18.11"
  },
  "koishi": {
    "description": {
      "zh": "将 ChatGPT 网页与本机 LM Studio 接入 QQ，支持连续对话、图片问答、网页生图、原生技能和多话题管理。网页模式需同机 Chrome 扩展。"
    },
    "preview": true
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node scripts/test.cjs",
    "check": "node scripts/check-project.cjs",
    "check:package": "node scripts/verify-package.cjs",
    "prepublishOnly": "npm run check && npm test && npm run check:package",
    "benchmark:queue": "node scripts/benchmark-queue.cjs",
    "doctor": "node scripts/doctor.cjs",
    "validate:lmstudio": "node scripts/validate-lmstudio-live.cjs",
    "validate:portrait": "node scripts/validate-portrait-live.cjs",
    "validate:thread-recovery": "node scripts/validate-thread-recovery-live.cjs",
    "setup:bridge": "node scripts/setup-web-bridge.cjs",
    "setup:extension": "node scripts/install-browser-extension.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
